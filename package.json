{
  "name": "personal-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "vite build && vite preview --port 4173 --strictPort",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.js",
    "test:e2e": "node test/e2e/finance.e2e.mjs",
    "test:e2e:countries": "node test/e2e/countries.e2e.mjs",
    "test:e2e:property": "node test/e2e/property.e2e.mjs",
    "test:e2e:portfolio": "node test/e2e/portfolio.e2e.mjs",
    "test:e2e:retirement": "node test/e2e/retirement.e2e.mjs",
    "dev:demo": "vite --mode demo",
    "build:demo": "vite build --mode demo --outDir dist-demo",
    "test:e2e:demo": "node test/e2e/demo.e2e.mjs",
    "test:e2e:home": "node test/e2e/home.e2e.mjs",
    "android:sync": "vite build && cap sync android",
    "android:open": "cap open android",
    "android:run": "vite build && cap sync android && cap run android",
    "test:e2e:android": "node test/e2e/android.e2e.mjs",
    "test:e2e:windows": "node test/e2e/windows.e2e.mjs",
    "android:assets": "capacitor-assets generate --android --iconBackgroundColor '#0f4c4c' --iconBackgroundColorDark '#0f4c4c' --splashBackgroundColor '#0f4c4c' --splashBackgroundColorDark '#0f4c4c'",
    "win:dev": "vite build && electron .",
    "win:build": "vite build && electron-builder --win --publish never",
    "app": "node scripts/run-as-app.mjs",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-shortcut.ps1",
    "test:e2e:pwa": "node test/e2e/pwa.e2e.mjs",
    "test:e2e:drive": "node test/e2e/drive.e2e.mjs",
    "build:nodefault": "VITE_GOOGLE_CLIENT_ID= vite build --outDir dist-nodefault",
    "test:e2e:flow": "node test/e2e/flow.e2e.mjs",
    "test:e2e:ai": "node test/e2e/ai.e2e.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@capgo/capacitor-social-login": "8.7.13",
    "exceljs": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "electron/main.cjs",
  "description": "Personal finance dashboard",
  "author": "Finance Dashboard",
  "build": {
    "appId": "io.github.saurskr.dashboard",
    "productName": "Finance Dashboard",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "FinanceDashboard-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "FinanceDashboard-${version}-portable.${ext}"
    }
  }
}
